+                    key={item.id}
+                    taskId={item.id}
+                    title={item.title}
+                    description={item.description}
+                    createdAt={item.createdAt}
+                    plannedDate={item.plannedDate}
+                    completedAt={item.completedAt}
+                    priority={item.priority}
+                    tags={item.tags}
+                    availableTags={availableTags}
+                    stageLabel={STAGE_LABELS[item.inboxStage]}
+                />
+            ))}
+        </div>
+    )
+}
