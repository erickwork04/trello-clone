+    type PersonalGroup,
+} from '@/lib/personal/group'
+
+interface PersonalListProps {
+    tasks: PersonalTask[]
+    availableTags: PersonalTag[]
+}
+
+const GROUP_ORDER: PersonalGroup[] = [
+    'routine',
+    'health',
+    'commitments',
+    'completed',
+]
