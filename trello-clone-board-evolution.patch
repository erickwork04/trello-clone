+ */
+async function findOwnedCard(cardId: string, boardId: string) {
+    const [row] = await db
+        .select({ id: card.id })
+        .from(card)
+        .innerJoin(boardColumn, eq(card.columnId, boardColumn.id))
+        .where(and(eq(card.id, cardId), eq(boardColumn.boardId, boardId)))
+        .limit(1)
+
+    return row
+}
